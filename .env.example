# Supermemory v5 key for the chain brain. Leave empty to boot without it.
# The real value belongs in the environment (Railway variable on clawd-validator), never in git.
SUPERMEMORY_API_KEY=

# Optional. Inside the validator image the default RPC is the local test validator.
# BRAIN_RPC=http://127.0.0.1:8899
# BRAIN_NAMESPACE=clawd-chain
# BRAIN_PORT=8091
# BRAIN_FROM=0
# BRAIN_WINDOW=8
# BRAIN_PAUSE_MS=50
# BRAIN_SNAPSHOT_EVERY=100
# BRAIN_DREAMING=instant
# BRAIN_STATE=/data/brain-state.json
